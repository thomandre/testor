#!/usr/bin/env php
<?php

declare(strict_types=1);

// Installed as a dependency (vendor/testor/testor/bin) or run from this repository.
foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new Testor\Cli())->run($argv));
